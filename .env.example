# Art Marketplace Docker Configuration
# Copy this file to .env and fill in your actual values

# Environment
NODE_ENV=production

# URLs
BACKEND_URL=http://localhost:3001
FRONTEND_URL=http://localhost:5173
VITE_BACKEND_URL=http://backend:3001

# Smart Contract
VITE_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
VITE_CHAIN_ID=11155111

# RPC
VITE_SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/your-infura-key

# Session
SESSION_SECRET=your-secure-random-secret-here-change-in-production

# Cloudflare Tunnel (optional - use for tunnel profile only)
CLOUDFLARED_TUNNEL_TOKEN=
