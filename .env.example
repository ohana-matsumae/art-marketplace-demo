# Art Marketplace Docker Configuration
# Copy this file to .env and fill in your actual values

# Public-facing URL of the frontend (used to build on-chain asset URIs)
# Local:      http://localhost:5173
# Cloudflare: https://your-tunnel-domain.trycloudflare.com
FRONTEND_URL=http://localhost:5173

# Smart Contract
VITE_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
VITE_CHAIN_ID=11155111

# RPC
VITE_SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/your-infura-key

# Session — generate with: openssl rand -hex 32
SESSION_SECRET=your-secure-random-secret-here-change-in-production

# Cloudflare Tunnel token (only needed when using --profile tunnel)
CLOUDFLARED_TUNNEL_TOKEN=
